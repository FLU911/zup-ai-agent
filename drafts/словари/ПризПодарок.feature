	#   manage_form_elements action=navigate_to_row table_name=Список
	#                        row_criteria=<Колонка>=<Фамилия Имя Отчество>
	# Убедиться через get_selected_rows, что выбран нужный человек,
	# и только тогда:
	И я нажимаю на кнопку с именем 'Выбрать'
	# Сумма вводится в колонку суммы дохода уже в таблице «Начисления»,
	# с обязательным table_name.

