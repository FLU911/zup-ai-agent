# Месяц — поле `ПериодРегистрации` (заголовок «Месяц»),
# НЕ `МесяцНачисленияСтрокой`.
#
#   click_button 'ФормаСоздать'
#   set_value 'Организация' <орг> exact_match:true
#   input_text 'ПериодРегистрации' "Январь 2026" → simulate_tab
#   activate_header_element 'Дата' → input_text '31.01.2026' → simulate_tab
#   click_button 'Заполнить'
#   click_button 'ФормаПровестиИЗакрыть'
#
# Все три организации цепляются в один вызов execute_form_actions.
#
# НЕ вызывать get_form_analysis на этой форме — таблицы начислений,
# НДФЛ и удержаний выводятся целиком, это тысячи строк.
# Контроль — get_table_data по документу.
