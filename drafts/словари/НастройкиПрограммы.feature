#    На одной форме может быть только одна из них. Проверять так:
#    нажать любую и, если «Кнопка с именем … не найдена», прочитать
#    напечатанный список кнопок таблицы — он полный.
#    Примеры из живых форм:
#      НачальнаяШтатнаяРасстановка → 'СотрудникиДобавить' ЕСТЬ
#      ПриемНаРаботуСписком        → только 'СотрудникиКонтекстноеМенюДобавить'
#      НазначениеПлановогоНачисления → только контекстное меню
#      ПозицияШтатногоРасписания   → 'НачисленияКонтекстноеМенюДобавить'
#      ИзменениеГрафикаРаботыСписком → 'ПоказателиСотрудниковДобавить'
#      ДанныеДляРасчетаЗарплаты    → 'ДанныеСводноКонтекстноеМенюДобавить'
#      ГрафикОтпусков              → 'СотрудникиКонтекстноеМенюДобавить'
#      ВедомостьНаВыплатуЗарплаты  → кнопки шапки 'Заполнить'/'Подобрать',
#                                    добавления строки вручную нет
#
# 2. ПОРЯДОК ЗАПОЛНЕНИЯ СТРОКИ, КОТОРЫЙ ВСЕГДА РАБОТАЕТ.
#      click_button   '<Таблица>[КонтекстноеМеню]Добавить'
#      open_choice_form '<Колонка-ссылка>' (table_name обязателен)
#        → в форме выбора navigate_to_row → select_row
#      activate_column '<Колонка-число/дата>'  (значение = ИМЯ колонки)
#      start_edit_row  (если таблица не в режиме редактирования)
#      input_text      '<Колонка>' + table_name
#      end_edit_row
#    end_edit_row обязателен: без него значение остаётся в поле
#    ввода и get_form_element_data по таблице возвращает ПУСТО.
#
# 3. ССЫЛОЧНЫЕ КОЛОНКИ — ТОЛЬКО open_choice_form.
#    set_value на колонке таблицы почти всегда даёт «Не получилось
#    сделать выбор», а иногда молча берёт ПЕРВЫЙ элемент списка
#    (так «Дополнительный отпуск за ненормированный рабочий день»
#    превращался в «Дополнительный неоплачиваемый отпуск ЧАЭС»).
#    input_text в ссылочную колонку кладёт СТРОКУ, а не ссылку.
#
# 4. ИМЯ КОЛОНКИ ≠ ЗАГОЛОВОК, И ЧАСТО СОДЕРЖИТ GUID.
#    activate_column с заголовком («Явка», «Дней работы») падает и
#    печатает ПОЛНЫЙ список полей таблицы — это самый дешёвый способ
#    снять имена. Колонки показателей выглядят как
#    '<Таблица>_<ИдентификаторПоказателя><32 знака hex>', колонки
#    часов графика — 'ЧасовПоВидуВремени<32 знака hex>'. GUID
#    привязан к элементу справочника в КОНКРЕТНОЙ базе.
#
# 5. ПОСЛЕ «ДОБАВИТЬ» СТРОКА МОЖЕТ ОКАЗАТЬСЯ ВТОРОЙ.
#    На формах, где строка редактируется в отдельном окне
#    (ПриемНаРаботуСписком) или где добавление идёт из контекстного
#    меню (НазначениеПлановогоНачисления), в таблице появляется
#    ПУСТАЯ строка N=1, а заполненные данные ложатся в N=2.
#    Всегда проверять состав get_form_element_data('<Таблица>')
#    и убирать пустышку '<Таблица>КонтекстноеМенюУдалить'.
#
# 6. ВЫДЕЛЕНИЕ «ВСЯ ТАБЛИЦА» БЛОКИРУЕТ РЕДАКТИРОВАНИЕ.
#    Сразу после открытия формы бывают выделены ВСЕ строки, и
#    input_text падает «В таблице выделено больше одной строки».
#    Лечится navigate_next_row + navigate_previous_row — выделение
#    становится одиночным.
#
# 7. ЧИТАТЬ ТАБЛИЦУ — get_form_element_data ПО ИМЕНИ ТАБЛИЦЫ.
#    get_selected_rows показывает только выделенное и врёт про
#    «общее количество строк». Пока строка в режиме редактирования,
#    get_form_element_data по таблице возвращает пустое значение —
#    сначала end_edit_row.
