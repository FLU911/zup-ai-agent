	И в поле с именем 'ФизическоеЛицо' я ввожу текст "$$Значение$$"
	# Договор
	И в поле с именем 'ДоговорЗайма' я ввожу текст "$$Значение$$"
	# Изменяется с
	И в поле с именем 'ДатаИзменений' я ввожу текст "$$Значение$$"
	И в поле с именем 'Дата' я ввожу текст "$$Значение$$"
	И в поле с именем 'Номер' я ввожу текст "$$Значение$$"
	# Заем предоставляется
	И в поле с именем 'СпособПредоставления' я ввожу текст "$$Значение$$"
	И в поле с именем 'Срок' я ввожу текст "$$Значение$$"
	И в поле с именем 'ПолныйСрок' я ввожу текст "$$Значение$$"
	# По
	И в поле с именем 'МесяцОкончания' я ввожу текст "$$Значение$$"
	# Ставка, %
	И в поле с именем 'ПроцентнаяСтавка' я ввожу текст "$$Значение$$"
	И в поле с именем 'ДатаВыдачи' я ввожу текст "$$Значение$$"
	И в поле с именем 'Сумма' я ввожу текст "$$Значение$$"
	# Погашение займа осуществляется
	И в поле с именем 'СпособПогашения' я ввожу текст "$$Значение$$"
	# Вид ежемесячных платежей
	И в поле с именем 'ВидПлатежей' я ввожу текст "$$Значение$$"
	# до
	И в поле с именем 'МесяцНачалаПогашения' я ввожу текст "$$Значение$$"
	И в поле с именем 'ОграничениеПлатежа' я ввожу текст "$$Значение$$"
	# Размер погашения основного долга
	И в поле с именем 'РазмерПогашения' я ввожу текст "$$Значение$$"
	# Размер платежа
	И в поле с именем 'РазмерПлатежа' я ввожу текст "$$Значение$$"
	И в поле с именем 'Комментарий' я ввожу текст "$$Значение$$"
	И в поле с именем 'Ответственный' я ввожу текст "$$Значение$$"

