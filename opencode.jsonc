{
  "$schema": "https://opencode.ai/config.json",

  // Конфиг уровня проекта для OpenCode.
  // Запускать opencode ИЗ КОРНЯ ПРОЕКТА, иначе блоки ниже не подхватятся.
  //
  // Цель — дать любой модели ровно тот же контекст, что есть у Claude Code:
  //   mcp          — тот же сервер Vanessa Automation и тот же клиент
  //                  тестирования 1С;
  //   instructions — правила проекта (CLAUDE.md) и справочники.
  //
  // Скиллы общие: в .claude/skills/ лежат SKILL.md, а в .opencode/command/
  // — короткие команды, которые их открывают. Одни и те же инструкции
  // работают в обоих инструментах, дублировать текст не нужно.

  "mcp": {
    "va": {
      "type": "remote",
      "url": "http://127.0.0.1:8080/mcp",
      "enabled": true
    }
  },

  "instructions": [
    "CLAUDE.md",
    "drafts/ДЛЯ-ДРУГИХ-ИИ/01-СИСТЕМНЫЙ-ПРОМПТ.md",
    "drafts/ДЛЯ-ДРУГИХ-ИИ/02-СПРАВОЧНИК-ЗАКРЫТИЕ-МЕСЯЦА.md"
  ]
}
